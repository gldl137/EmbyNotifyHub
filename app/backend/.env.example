# =============================================================================
# EmbyNotifyHub 环境变量示例
# 复制为 .env 后按需填写；也可以什么都不填，直接在 Web 界面「设置」里配置
# （Web 界面的配置会保存到 data/config.json，优先级更高）
# =============================================================================

# TMDB API Key（可选，用于获取海报、评分、简介等媒体增强信息）
# 申请地址: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# 企业微信配置（可选，也可在 Web 界面添加）
WECOM_CORPID=
WECOM_AGENTID=
WECOM_SECRET=
WECOM_TOUSER=@all

# Emby 配置（可选，也可在 Web 界面添加多个服务器）
EMBY_BASE_URL=
EMBY_API_KEY=

# 服务端口 / 监听地址
PORT=7000
HOST=0.0.0.0

# 缓存（秒）
CACHE_TTL_TMDB=86400
CACHE_TTL_TOKEN=7200
